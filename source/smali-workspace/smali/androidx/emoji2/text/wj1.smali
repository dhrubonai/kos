47\uff92\uff9a\u8a96\ufff1\uff11\uff8b\uff8b\u6a59\uff8c\uffc5\u8c2e\uffd0\uff88\u3308\uffd1\uff92\u8adc\uffd0\ufffb\uff11\uff8b\uff8b\u6a59\uffec\uff11\uff8b\uff8b\u6a59\uff8c\uffc5\u8c2e\uffd0\uff9b\u3300\uff8c\uff9c\u8ad6\uff8d\uff9b\ubc3f\uff98\uff98\u1fd6\uffe5\uff18\uff91\uff9b\u6a5b\uff90\uff96\u8c65\uffd1\uff96\u3307\uff8b\uff9a\u8ad7\uff8b\uffd1\ubc70\uff9c\uff8b\u1f90\uff90\uff91\u6687\uffbb\uffb6\u0c43\uffb3\ufffb\uff0d\uff9a\uff93\u6a13\ufff8\uff1a\uff90\uff8a\u6a47\uff8b\uff8d\u8c78\ufff8\uff1a\uff90\uff8a\u6a47\uff8b\uff8d\u8c78\uffec\uff2a\uff9a\uff93\u6a45\uff9a\uff8d\u8c4d\uff96\uff8c\u331d\uffd7\uff9c\u8ad6\uff8a\uff91\ubc65\uff8d\uff86\u1fc4\ufff9\uff0a\uff9a\uff93\u6a45\uff9a\uff8d\ufff4\uff1a\uff90\uff8a\u6a47\uff8b\uff8d\u8c78\uffb1\uff9e\u3304\uff9a\ufff9\uff0a\uff9a\uff93\u6a45\uff9a\uff8d\ufff4\uff1a\uff90\uff8a\u6a47\uff8b\uff8d\u8c78\uffb1\uff9e\u3304\uff9a\uffea\uff2a\uff9a\uff93\u6a45\uff9a\uff8d\u8c51\uff8d\uff90\u330f\uff96\uff93\u8adc\uffd7\uff8c\ubc74\uff93\uff93\u1f9c\uff8d\uffc2\ufff1\uff55\uffdf\uff9c\u6a46\uff8a\uff91\u8c75\uff8d\uff86\u3327\uff9e\uff92\u8adc\uffc2\ufffb\uff0d\uff9a\uff87\u6a5d\ufffb\uff10\uff9c\uff90\u6a47\ufff7\uff1e\uff8d\uff9e\u6a4d\uff96\uff9a\u8c6f\uff8b\ufffb\uff0d\uff9a\uff87\u6a5d\ufffb\uff10\uff9c\uff90\u6a47\ufff7\uff1e\uff8d\uff9e\u6a4d\uff96\uff9a\u8c6f\uff8b\uffe6\uff2a\uff8a\uff9d\u6a5a\uff9c\uff8d\u8c68\uff8f\uff8b\u3300\uff90\uff91\u8aec\uff96\uffac\ubc65\uff9e\uff8b\u1f9c\uffd7\uff8b\u66cc\uff87\uff8b\u0c3f\ufff8\uff55\uffdf\uff96\u6a4a\uff90\uff91\u8c3c\ufff4\uff55\uffdf\uff98\u6a5b\uff9e\uff9b\u8c68\uff9a\uff91\u331d\uffc2\ufff0\uff55\uffdf\uff96\u6a5a\uffbe\uff9c\u8c75\uff96\uff90\u3307\uff9e\uff9d\u8ad5\uff9a\uffc2\ufff7\uff11\uff90\uff92\u6a4c\uffbe\uff8f\u8c71\uff8c\ufff8\uff18\uff93\uff93\u6a68\uff8f\uff8f\u8c72\ufff1\uff1e\uff90\uff90\u6a4e\uff93\uff9a\u8c40\uff9c\uff9c\u3306\uff8a\uff91\u8acd\uff8c\uffef\uff1d\uff9a\uff89\u6a4c\uff93\uff90\u8c71\uff9a\uff8d\u3324\uff90\uff9b\u8acc\uff93